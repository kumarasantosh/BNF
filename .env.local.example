# ─────────────────────────────────────────────────────────────────────────────
# Bank Nifty Dashboard — Environment Variables
# Copy this file to .env.local and fill in your real credentials.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firstock API Credentials ──────────────────────────────────────────────────
# Obtain these from: https://connect.thefirstock.com
# Dashboard → API Keys section

# Optional: point to the same JSON file used by the Firstock Python SDK sample.
# Example: /Users/santosh/Downloads/10-firstock/credentials.json
FIRSTOCK_CREDENTIALS_FILE=

# Your Firstock registered user ID (mobile number or client ID)
FIRSTOCK_USER_ID=

# Your Firstock login password
FIRSTOCK_PASSWORD=

# SDK-style second factor sent as Firstock's TOTP field.
# In the Python SDK this is passed as TOTP/factor2 and may be DOB/PAN/PIN, not an authenticator OTP.
FIRSTOCK_FACTOR2=

# Backward-compatible legacy name. Prefer FIRSTOCK_FACTOR2 or FIRSTOCK_CREDENTIALS_FILE.
# FIRSTOCK_TOTP=

# Your Firstock vendor code (provided when you register for API access)
FIRSTOCK_VENDOR_CODE=

# API secret key from Firstock portal
FIRSTOCK_API_KEY=

# ── App Config ────────────────────────────────────────────────────────────────
# Set to "true" to use mock data even if Firstock credentials are present (useful for dev)
USE_MOCK_DATA=false

# Protects /api/cron/nse-vega in production. Vercel Cron sends this as:
# Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ── NSE Vega Dashboard ────────────────────────────────────────────────────────
# Uses:
# https://www.nseindia.com/api/NextApi/apiClient/GetQuoteApi?functionName=getOptionChainData&symbol=NIFTY&params=expiryDate=16-Jun-2026
VEGA_SYMBOL=NIFTY
VEGA_EXPIRY_DATE=16-Jun-2026
VEGA_STRIKE_WINDOW=12
VEGA_CAPTURE_START_TIME=09:15
VEGA_CAPTURE_END_TIME=15:30
VEGA_POLL_INTERVAL_MS=60000
VEGA_NSE_TIMEOUT_MS=7000

# Default seller-perspective rule:
# diff = put-vega change - call-vega change
# diff >= +5  -> BEARISH, diff <= -5 -> BULLISH
# within +/-5 -> SIDEWAYS BEARISH/BULLISH bias by sign
VEGA_TREND_THRESHOLD=5
VEGA_NEUTRAL_BAND=0.05

# Optional full override. Rules are evaluated in order.
# VEGA_TREND_RULES_JSON='[{"signal":"BULLISH","minDiff":-1000000,"maxDiff":-5},{"signal":"BEARISH","minDiff":5,"maxDiff":1000000},{"signal":"SIDEWAYS BULLISH","minDiff":-5,"maxDiff":-0.05},{"signal":"SIDEWAYS BEARISH","minDiff":0.05,"maxDiff":5},{"signal":"SIDEWAYS","minDiff":-0.05,"maxDiff":0.05}]'

# ── Future Extensions ─────────────────────────────────────────────────────────
# Add keys here as you extend the dashboard (e.g., option chain, IV feed, etc.)
# OPTION_CHAIN_PROVIDER_KEY=
# IV_FEED_KEY=
